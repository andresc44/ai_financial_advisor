# Finnbot settings. Copy to .env and fill in; check with: venv/bin/python -m src.config.check_config
# (Claude-authored 2026-10-15)

# --- Shared keys ---
FINNHUB_API_KEY=  # required: Finnhub, shared market data
TWELVEDATA_API_KEY=  # optional: Twelve Data: only indicators not computed from Yahoo prices (TECHNICAL_INDICATOR_SOURCE)
ANTHROPIC_API_KEY=  # required when LLM['UNIVERSAL'] is a Claude model: Claude for the universal recommendations (shared)
DEEPSEEK_API_KEY=  # required when LLM['UNIVERSAL'] is a DeepSeek model: DeepSeek for the universal recommendations (shared)
UNIVERSAL_LLM_MODEL=  # optional: LLM for the universal recommendations, overriding LLM['UNIVERSAL'] in parameters.py, e.g. deepseek-flash
UNIVERSAL_LLM_EFFORT=  # optional: its effort. Claude: low, medium, high, xhigh, max; DeepSeek: none (no thinking), low, high, max
GMAIL_USER=  # required: Gmail account the digest is sent from
GMAIL_APP_PASSWORD=  # required: App password for that Gmail account
TELEGRAM_BOT_TOKEN=  # required: Telegram bot for alerts and notices
GOOGLE_APPLICATION_CREDENTIALS=  # optional: Service-account JSON path; needed to read private Google Sheets
GEMINI_API_KEY=  # optional: Gemini for the macro news (shared; only when headline news is enabled)
FRED_API_KEY=  # optional: FRED yield curve (only when market indicators are enabled)
SIGNUP_FORM_SHEET_ID=  # optional: the sign-up form's answers sheet, shared with the service account; without it new sign-ups aren't imported

# --- Monitoring and backups (docs/operations.md) ---
HEALTHCHECKS_PING_KEY=  # optional: healthchecks.io ping key; without it cron jobs run unmonitored
FINNBOT_BACKUP_REMOTE=  # optional: rclone destination for the nightly backup (default finnbot-backup:)
FINNBOT_BACKUP_KEEP_DAYS=  # optional: Days to keep replaced files in the backup (default 90)
FINNBOT_LOGS_REMOTE=  # optional: Where the backup copies logs/ (default gdrive:finnbot-logs, not encrypted; finnbot-backup:logs to encrypt; none to leave them out)

# --- One block per user in ACTIVE_USERS (src/config/parameters.py). Print a new user's block with:
#     venv/bin/python -m src.config.check_config --template <Name>
# --- Alex (python -m src.config.check_config --template Alex) ---
ALEX_EMAIL=  # required: Where the digest is sent
ALEX_INSTITUTION=  # required with holdings: Brokerage name shown in the digest, e.g. Questrade
ALEX_TIMEZONE=  # required with holdings: IANA timezone, e.g. America/Toronto
ALEX_HOME_CURRENCY=  # optional: USD, CAD, EUR, GBP, AUD, COP: the overview shows the portfolio in it and in USD (default USD)
ALEX_TELEGRAM_CHAT_ID=  # optional: Telegram chat ID; without it there are no watchdog alerts or notices
ALEX_SNAPTRADE_CLIENT_ID=  # required for SNAPTRADE: SnapTrade personal client ID
ALEX_SNAPTRADE_CONSUMER_KEY=  # required for SNAPTRADE: SnapTrade personal consumer key
ALEX_HOLDINGS_SOURCE=  # required: SNAPTRADE, SHEETS, or NO_HOLDINGS
ALEX_SHEETS_ID=  # required for SHEETS: ID of the holdings Google Sheet (from its URL)
ALEX_RECEIVE_PREMARKET_DIGEST=  # required: True or False: send the 07:00 ET digest
ALEX_RECEIVE_POSTMARKET_DIGEST=  # required: True or False: send the after-close digest
ALEX_WATCHDOG_INTERVAL_HOURS=  # optional: Hours between watchdog checks, 0 = off (default 4)
ALEX_WATCHDOG_SESSION=  # optional: regular, extended, or 24_7 (default regular)
ALEX_WATCHDOG_TRIPWIRE=  # optional: true or false: hourly price check between checks
ALEX_HOLDINGS_LLM_MODEL=  # optional: LLM for holdings: a model in ALLOWED_CLAUDE_MODELS or ALLOWED_DEEPSEEK_MODELS (default LLM['HOLDINGS'])
ALEX_HOLDINGS_LLM_EFFORT=  # optional: Claude: low..max; DeepSeek: none (no thinking), low, high, or max
ALEX_HOLDINGS_CLAUDE_MODEL=  # optional: Older name for HOLDINGS_LLM_MODEL (used when that's unset)
ALEX_HOLDINGS_CLAUDE_EFFORT=  # optional: Older name for HOLDINGS_LLM_EFFORT (used when that's unset)
ALEX_RECEIVE_HOLDING_NEWS=  # optional: True or False: Gemini news bullets for each holding (default True)
ALEX_ANTHROPIC_API_KEY=  # required with holdings on a Claude model: The user's own Anthropic key (holdings evaluation on a Claude model)
ALEX_DEEPSEEK_API_KEY=  # required with holdings on a DeepSeek model: The user's own DeepSeek key (holdings evaluation on a DeepSeek model)
ALEX_GEMINI_API_KEY=  # required with holdings: The user's own Gemini key (holding news and portfolio review)
